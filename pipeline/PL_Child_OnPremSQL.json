{
	"name": "PL_Child_OnPremSQL",
	"properties": {
		"activities": [
			{
				"name": "CP_OnPremSQL_To_ADLS",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "@dataset().pQuery",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_SQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"pSchema": {
								"value": "@pipeline().parameters.pSourceSchema",
								"type": "Expression"
							},
							"pTable": {
								"value": "@pipeline().parameters.pSourceObject",
								"type": "Expression"
							},
							"pQuery": {
								"value": "@concat(\n    'SELECT * FROM [', pipeline().parameters.pSourceSchema,\n    '].[', pipeline().parameters.pSourceObject, ']',\n    if(\n        and(\n            equals(\n                toUpper(pipeline().parameters.pLoadType),\n                'INCREMENTAL'\n            ),\n            and(\n                not(\n                    equals(\n                        pipeline().parameters.pWatermarkColumn,\n                        ''\n                    )\n                ),\n                not(\n                    equals(\n                        pipeline().parameters.pLastWatermarkValue,\n                        ''\n                    )\n                )\n            )\n        ),\n        concat(\n            ' WHERE [',\n            pipeline().parameters.pWatermarkColumn,\n            '] > ''',\n            pipeline().parameters.pLastWatermarkValue,\n            ''''\n        ),\n        ''\n    )\n)",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Parquet_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"pFolderPath": {
								"value": "\n@concat(\n    'raw/OnPremSQL/',\n    pipeline().parameters.pSourceSchema,\n    '/',\n    pipeline().parameters.pSourceObject\n)\n",
								"type": "Expression"
							},
							"pFileName": {
								"value": "\n@concat(\n    pipeline().parameters.pSourceObject,\n    '.parquet'\n)\n",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SP_Log_Process_Start",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_ProcessLog_Start]",
					"storedProcedureParameters": {
						"ProcessId": {
							"value": "@pipeline().parameters.pProcessId"
						},
						"BatchId": {
							"value": ""
						},
						"PipelineRunId": {
							"value": "@pipeline().RunId"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"pProcessId": {
				"type": "int"
			},
			"pSourceSchema": {
				"type": "string"
			},
			"pSourceObject": {
				"type": "string"
			},
			"pLoadType": {
				"type": "string"
			},
			"pWatermarkColumn": {
				"type": "string"
			},
			"pLastWatermarkValue": {
				"type": "string"
			},
			"pBatchId": {
				"type": "string"
			}
		},
		"annotations": []
	}
}