							"value": "@activity('CP_OnPremSQL_To_ADLS').error.errorCode"
						},
						"RuleName": {
							"value": "ADF_Copy_Failure"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "LK_Get_Source_MaxWatermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "CP_OnPremSQL_To_ADLS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@if(\n    equals(toUpper(pipeline().parameters.pLoadType), 'INCREMENTAL'),\n    concat(\n        'SELECT MAX([',\n        pipeline().parameters.pWatermarkColumn,\n        ']) AS MaxWatermark FROM [',\n        pipeline().parameters.pSourceSchema,\n        '].[',\n        pipeline().parameters.pSourceObject,\n        ']'\n    ),\n    'SELECT CAST(NULL AS datetime2) AS MaxWatermark'\n)\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"pSchema": {
								"value": "@pipeline().parameters.pSourceSchema",
								"type": "Expression"
							},
							"pTable": {
								"value": "@pipeline().parameters.pSourceObject",
								"type": "Expression"
							},
							"pQuery": {
								"value": "\n@concat(\n    'SELECT * FROM [',\n    pipeline().parameters.pSourceSchema,\n    '].[',\n    pipeline().parameters.pSourceObject,\n    ']'\n)\n",
								"type": "Expression"
							}
						}
