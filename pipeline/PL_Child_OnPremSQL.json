{
	"name": "PL_Child_OnPremSQL",
	"properties": {
		"activities": [
			{
				"name": "CP_OnPremSQL_To_ADLS",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "LK_Get_ProcessLogId",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "\n@concat(\n    'SELECT * FROM [',\n    pipeline().parameters.pSourceSchema,\n    '].[',\n    pipeline().parameters.pSourceObject,\n    ']',\n    if(\n        and(\n            equals(toUpper(pipeline().parameters.pLoadType), 'INCREMENTAL'),\n            not(empty(pipeline().parameters.pLastWatermarkValue))\n        ),\n        concat(\n            ' WHERE [',\n            pipeline().parameters.pWatermarkColumn,\n            '] > ''',\n            pipeline().parameters.pLastWatermarkValue,\n            ''''\n        ),\n        ''\n    )\n)\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_SQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"pSchema": {
								"value": "@pipeline().parameters.pSourceSchema",
								"type": "Expression"
							},
							"pTable": {
								"value": "@pipeline().parameters.pSourceObject",
								"type": "Expression"
							},
							"pQuery": {
								"value": "\n@concat(\n    'SELECT * FROM [',\n    pipeline().parameters.pSourceSchema,\n    '].[',\n    pipeline().parameters.pSourceObject,\n    ']',\n    if(\n        and(\n            equals(\n                toUpper(pipeline().parameters.pLoadType),\n                'INCREMENTAL'\n            ),\n            not(\n                empty(pipeline().parameters.pLastWatermarkValue)\n            )\n        ),\n        concat(\n            ' WHERE [',\n            pipeline().parameters.pWatermarkColumn,\n            '] > ''',\n            pipeline().parameters.pLastWatermarkValue,\n            ''''\n        ),\n        ''\n    )\n)\n",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Parquet_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"pFolderPath": {
								"value": "\n@concat(\n    'raw/OnPremSQL/',\n    pipeline().parameters.pSourceSchema,\n    '/',\n    pipeline().parameters.pSourceObject\n)\n",
								"type": "Expression"
							},
							"pFileName": {
								"value": "\n@concat(\n    pipeline().parameters.pSourceObject,\n    '.parquet'\n)\n",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SP_Log_Process_Start",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_ProcessLog_Start]",
					"storedProcedureParameters": {
						"ProcessId": {
							"value": "@pipeline().parameters.pProcessId"
						},
						"BatchId": {
							"value": "@pipeline().parameters.pBatchId"
						},
						"PipelineRunId": {
							"value": "@pipeline().RunId"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "LK_Get_ProcessLogId",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "SP_Log_Process_Start",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'SELECT TOP (1) ProcessLogId ',\n    'FROM dbo.ProcessLog ',\n    'WHERE ProcessId = ',\n    string(pipeline().parameters.pProcessId),\n    ' AND BatchId = ''',\n    pipeline().parameters.pBatchId,\n    ''' AND PipelineRunId = ''',\n    pipeline().RunId,\n    ''' ORDER BY ProcessLogId DESC'\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"pSchema": "dbo",
							"pTable": "ProcessLog"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "SP_Log_Process_Success",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "LK_Get_Source_MaxWatermark",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_ProcessLog_Update]",
					"storedProcedureParameters": {
						"ProcessLogId": {
							"value": {
								"value": "@activity('LK_Get_ProcessLogId').output.firstRow.ProcessLogId",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"Status": {
							"value": "Succeeded",
							"type": "String"
						},
						"RowsRead": {
							"value": "@activity('CP_OnPremSQL_To_ADLS').output.rowsRead",
							"type": "Int64"
						},
						"RowsWritten": {
							"value": "@activity('CP_OnPremSQL_To_ADLS').output.rowsCopied",
							"type": "Int64"
						},
						"ErrorMessage": {
							"value": "' '",
							"type": "String"
						},
						"ProcessId": {
							"value": "@pipeline().parameters.pProcessId",
							"type": "Int32"
						},
						"UpdateWatermark": {
							"value": {
								"value": "\n@equals(\n    toUpper(pipeline().parameters.pLoadType),\n    'INCREMENTAL'\n)\n",
								"type": "Expression"
							},
							"type": "Boolean"
						},
						"LastCommittedWatermark": {
							"value": "@activity('LK_Get_Source_MaxWatermark').output.firstRow.MaxWatermark",
							"type": "Datetime"
						},
						"LastSuccessfulBatchId": {
							"value": "@pipeline().parameters.pBatchId",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Log_Process_Failure",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "CP_OnPremSQL_To_ADLS",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_ProcessLog_Update]",
					"storedProcedureParameters": {
						"ProcessLogId": {
							"value": "@activity('LK_Get_ProcessLogId').output.firstRow.ProcessLogId"
						},
						"Status": {
							"value": "Failed"
						},
						"RowsRead": {
							"value": "0"
						},
						"RowsWritten": {
							"value": "0"
						},
						"ErrorMessage": {
							"value": "@activity('CP_OnPremSQL_To_ADLS').error.message"
						},
						"ProcessId": {
							"value": "@pipeline().parameters.pProcessId"
						},
						"BatchId": {
							"value": "@pipeline().parameters.pBatchId"
						},
						"PipelineRunId": {
							"value": "@pipeline().RunId"
						},
						"ExceptionType": {
							"value": "PipelineFailure"
						},
						"SourceObject": {
							"value": "@concat(pipeline().parameters.pSourceSchema, '.', pipeline().parameters.pSourceObject)"
						},
						"FileUri": {
							"value": "@concat('raw/OnPremSQL/', pipeline().parameters.pSourceSchema, '/', pipeline().parameters.pSourceObject, '/', pipeline().parameters.pSourceObject, '.parquet')"
						},
						"ErrorCode": {
							"value": "@activity('CP_OnPremSQL_To_ADLS').error.errorCode"
						},
						"RuleName": {
							"value": "ADF_Copy_Failure"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "LK_Get_Source_MaxWatermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "CP_OnPremSQL_To_ADLS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "\n@concat(\n    'SELECT MAX([',\n    pipeline().parameters.pWatermarkColumn,\n    ']) AS MaxWatermark FROM [',\n    pipeline().parameters.pSourceSchema,\n    '].[',\n    pipeline().parameters.pSourceObject,\n    ']'\n)\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"pSchema": {
								"value": "@pipeline().parameters.pSourceSchema",
								"type": "Expression"
							},
							"pTable": {
								"value": "@pipeline().parameters.pSourceObject",
								"type": "Expression"
							},
							"pQuery": {
								"value": "@concat('SELECT MAX([', pipeline().parameters.pWatermarkColumn, ']) AS MaxWatermark FROM [', pipeline().parameters.pSourceSchema, '].[', pipeline().parameters.pSourceObject, ']')",
								"type": "Expression"
							}
						}
					}
				}
			}
		],
		"parameters": {
			"pProcessId": {
				"type": "int"
			},
			"pSourceSchema": {
				"type": "string"
			},
			"pSourceObject": {
				"type": "string"
			},
			"pLoadType": {
				"type": "string"
			},
			"pWatermarkColumn": {
				"type": "string"
			},
			"pLastWatermarkValue": {
				"type": "string"
			},
			"pBatchId": {
				"type": "string"
			}
		},
		"annotations": []
	}
}