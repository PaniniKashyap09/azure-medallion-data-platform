						"Status": {
							"value": "Succeeded",
							"type": "String"
						},
						"RowsRead": {
							"value": "@activity('CP_OnPremSQL_To_ADLS').output.rowsRead",
							"type": "Int64"
						},
						"RowsWritten": {
							"value": "@activity('CP_OnPremSQL_To_ADLS').output.rowsCopied",
							"type": "Int64"
						},
						"ErrorMessage": {
							"value": "' '",
							"type": "String"
						},
						"ProcessId": {
							"value": "@pipeline().parameters.pProcessId",
							"type": "Int32"
						},
						"UpdateWatermark": {
							"value": {
								"value": "\n@equals(\n    toUpper(pipeline().parameters.pLoadType),\n    'INCREMENTAL'\n)\n",
								"type": "Expression"
							},
							"type": "Boolean"
						},
						"LastCommittedWatermark": {
							"value": "@activity('LK_Get_Source_MaxWatermark').output.firstRow.MaxWatermark",
							"type": "Datetime"
						},
						"LastSuccessfulBatchId": {
							"value": "@pipeline().parameters.pBatchId",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Log_Process_Failure",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "CP_OnPremSQL_To_ADLS",
						"dependencyConditions": [
							"Failed"
